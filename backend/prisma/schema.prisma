// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String        @id @default(uuid())
  name                  String
  email                 String        @unique
  password              String
  role                  String        @default("client") // admin, manager, staff, client
  specialization        String[]
  approveBookings       Boolean       @default(false)
  manageStaff           Boolean       @default(false)
  manageServices        Boolean       @default(false)
  resetPasswordToken    String?
  resetPasswordExpire   DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  services              Service[]     @relation("ServiceStaff")
  clientAppointments    Appointment[] @relation("ClientAppointments")
  staffAppointments     Appointment[] @relation("StaffAppointments")
  handledAppointments   Appointment[] @relation("HandledBy")
}

model Service {
  id              String        @id @default(uuid())
  name            String
  category        String
  price           String
  image           String?
  description     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  assignedStaff   User[]        @relation("ServiceStaff")
  appointments    Appointment[]
}

model Appointment {
  id                 String   @id @default(uuid())
  name               String?  // Legacy support
  phone              String?  // Legacy support
  email              String?  // Legacy support
  
  clientId           String?
  client             User?    @relation("ClientAppointments", fields: [clientId], references: [id])
  
  serviceId          String?
  serviceRelation    Service? @relation(fields: [serviceId], references: [id])
  
  staffId            String?
  staff              User?    @relation("StaffAppointments", fields: [staffId], references: [id])
  
  service            String   // Current service name (snapshot)
  date               String
  time               String
  
  status             String   @default("pending") // pending, approved, rejected, completed, cancelled
  
  price              Float    @default(0)
  paymentStatus      String   @default("unpaid") // unpaid, paid, partial
  paymentMethod      String?
  receiptNo          String?  @unique
  
  handledById        String?
  handledBy          User?    @relation("HandledBy", fields: [handledById], references: [id])
  
  notes              String?
  cancellationReason String?
  
  isDeleted          Boolean  @default(false)
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Enquiry {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  message   String
  status    String   @default("new") // new, in-progress, resolved, closed
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
